# Copy to .env and fill in real values
PROJECT_NAME=Upselling Product API
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite+aiosqlite:///./upselling.db
CORS_ORIGINS=["http://localhost:3000"]

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_STORE_URL=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-07

# Embeddings for the admin agent's RAG memory (pgvector on Postgres).
# Leave EMBEDDING_API_KEY empty to use the built-in local embedder.
EMBEDDING_PROVIDER=auto
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
