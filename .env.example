# Copy to .env and fill in real values
PROJECT_NAME=Upselling Product API
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite+aiosqlite:///./upselling.db
CORS_ORIGINS=["http://localhost:3000"]

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_STORE_URL=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-07

# Embeddings for the admin agent's RAG memory (pgvector on Postgres).
# Leave EMBEDDING_API_KEY empty to use the built-in local embedder.
EMBEDDING_PROVIDER=auto
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536



# ── Order self-service ─────────────────────────────────────────────────────
# Lets a shopper cancel an order or move its delivery address from the chat.
# Needs the `write_orders` Admin scope. Turn off to remove both tools.
SUPPORT_ORDER_CHANGES=true
# Before either write, the shopper must confirm the postcode already on the
# order. Leave this on unless the request itself is authenticated: an order
# number and an email are both guessable, and together they are a weak secret.
SUPPORT_VERIFY_ORDER_CHANGES=true
SUPPORT_CHANGE_TTL_MINUTES=15
SUPPORT_CHANGE_MAX_ATTEMPTS=3
# Past this many days a cancellation is really a return, and a human takes it.
SUPPORT_CANCEL_WINDOW_DAYS=14
